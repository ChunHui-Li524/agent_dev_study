# ============================================
# Phase 6: PySide6 桌面 UI - 环境变量
# ============================================
# 本文件仅为示例，实际配置请使用项目根目录的 .env 文件
# 或在 phase6_ui/config/ 下复制为 .env 并填入密钥
#
# Windows: copy config\.env.example config\.env
# 然后编辑 config\.env 填入 OPENAI_API_KEY 等

# OpenAI（或通义等 OpenAI 兼容端点）
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
